# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# The +asyncpg driver is required (the app uses async SQLAlchemy).
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/cryptolens

# --- Redis ---
# Optional: leave empty to run without Redis (no-op cache). Set to a real
# instance to enable caching.
REDIS_URL=redis://localhost:6379/0

# --- News provider (NewsData.io) ---
# Get a free key at https://newsdata.io — the app runs without one,
# but the news feed will stay empty until a key is provided.
NEWSDATA_API_KEY=
NEWS_CACHE_TTL=300
NEWS_REFRESH_INTERVAL=900

# --- Market provider (CoinGecko public API, no key required) ---
MARKET_CACHE_TTL=120

# --- Blogs: external articles from crypto RSS feeds (no key required) ---
# Comma-separated source slugs to enable, from app/modules/blog/providers/rss/
# feeds.py (cointelegraph, coindesk). Leave empty to enable every feed.
BLOG_RSS_FEEDS=
BLOG_CACHE_TTL=600
BLOG_REFRESH_INTERVAL=3600

# --- Authentication (JWT) ---
# Signing secret for access tokens. MUST be a strong random value in production
# (the app refuses to start with the default when ENVIRONMENT=production).
JWT_SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Bootstrap admin (used by `python -m scripts.create_admin`) ---
# Blog authoring requires a signed-in user whose role is `admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS (comma-separated origins) ---
# Both spellings of localhost: the browser treats them as distinct origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
